---
const nav = [
  { label: "Services", href: "#services" },
  { label: "Work", href: "#work" },
  { label: "About", href: "#about" },
  { label: "Contact", href: "#contact" },
];
---

<footer class="foot dark">
  <div class="wrap foot__inner">
    <a class="foot__mark" href="#top" aria-label="RIV, back to top">
      <img class="foot__logo" src="/logo-white.png" alt="RIV" width="800" height="430" loading="lazy" />
    </a>

    <nav aria-label="Footer">
      <ul class="foot__nav">
        {
          nav.map((n) => (
            <li>
              <a href={n.href}>{n.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="foot__meta">
      <p>Built and Designed by RIV Information Technology Services: Build your business website systems with us today!</p>
      <p>Registered business name, Department of Trade and Industry, Philippines.</p>
      <p>Source for this site: <a href="https://github.com/RenzRamido/riv-website" target="_blank" rel="noopener noreferrer">github.com/RenzRamido/riv-website</a></p>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--navy);
    border-top: 1px solid var(--line-dark);
    padding-block: 40px;
  }

  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
  }

  .foot__mark {
    display: inline-flex;
    align-items: center;
  }

  .foot__logo {
    display: block;
    height: 32px;
    width: auto;
  }

  .foot__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
  }

  .foot__nav a {
    display: inline-block;
    padding-block: 4px;
    font-size: 0.9rem;
    color: var(--mute-dark);
    transition: color 0.3s var(--ease);
  }

  .foot__nav a:hover {
    color: #fff;
  }

  .foot__meta a {
    display: inline-block;
    padding-block: 4px;
    color: var(--mute-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.3s var(--ease);
  }

  .foot__meta a:hover {
    color: #fff;
  }

  .foot__meta {
    display: grid;
    gap: 6px;
    flex-basis: 100%;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: #6d7796;
  }
</style>
