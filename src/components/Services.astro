---
const stages = [
  {
    n: "01",
    title: "Capture",
    broken: "Money leaves every month. You cannot say which calls it bought.",
    built: "Google Ads built from zero, conversion tracking that fires on real submissions, a Google Business Profile that is actually filled in, and a website built to turn a visitor into a phone call.",
  },
  {
    n: "02",
    title: "Qualify and route",
    broken: "Every inquiry lands in one inbox and waits for a person to open it.",
    built: "Leads are read, sorted, and answered in under five minutes, then sent to whoever should actually handle them.",
  },
  {
    n: "03",
    title: "Quote",
    broken: "The customer is ready on Tuesday. The quote reaches him on Friday.",
    built: "Your pricing rules written down once, then applied automatically. The estimate goes out while he is still interested.",
  },
  {
    n: "04",
    title: "Book",
    broken: "Three messages back and forth to find a time.",
    built: "He picks a slot himself. The job lands in your calendar and your CRM at the same moment.",
  },
];
---

<section class="section services" id="services">
  <div class="wrap services__grid">
    <div class="services__aside">
      <div class="services__stick">
        <h2 data-reveal>One system, from the first click to the booked job</h2>
        <p class="lede" data-reveal style="--delay:120ms">
          Not a website, not an ads account, not an automation. The three of them wired together,
          which is the only version that still works at 9pm on a Saturday.
        </p>
      </div>
    </div>

    <ol class="services__list">
      {
        stages.map((s, i) => (
          <li class="svc" data-reveal style={`--delay:${i * 70}ms`}>
            <span class="svc__icon" aria-hidden="true">{s.n}</span>

            <div class="svc__text">
              <h3>{s.title}</h3>
              <p><span class="svc__key">Broken:</span> {s.broken}</p>
              <p><span class="svc__key">Built:</span> {s.built}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services {
    background: var(--haze);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .services__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(38px, 6vw, 92px);
  }

  .services__stick {
    position: sticky;
    top: 130px;
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .services__list {
    display: grid;
  }

  .svc {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 22px;
    padding: 30px 26px 30px 0;
    border-top: 1px solid var(--line-strong);
    position: relative;
    transition: padding 0.45s var(--ease);
  }

  .svc:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .svc::before {
    content: "";
    position: absolute;
    inset: 0 -22px;
    background: var(--paper);
    opacity: 0;
    transform: scaleX(0.97);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
    z-index: -1;
  }

  .svc:hover::before {
    opacity: 1;
    transform: none;
  }

  .svc:hover {
    padding-left: 12px;
  }

  .svc__icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--ink-2);
    transition: color 0.4s var(--ease), border-color 0.4s var(--ease), transform 0.5s var(--ease);
  }

  .svc__icon {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .svc__key {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  .svc:hover .svc__icon {
    color: var(--blue);
    border-color: var(--blue);
    transform: rotate(-6deg) scale(1.06);
  }

  .svc__text {
    display: grid;
    gap: 9px;
  }

  .svc__text p {
    color: var(--mute);
    font-size: 0.98rem;
    line-height: 1.66;
    max-width: 56ch;
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
    }

    .services__stick {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .svc {
      grid-template-columns: 1fr;
      gap: 16px;
      padding-right: 0;
    }

    .svc:hover {
      padding-left: 0;
    }
  }
</style>
