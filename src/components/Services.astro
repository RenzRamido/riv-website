---
const stages = [
  {
    n: "01",
    title: "Capture",
    copy: "A website and Google Ads account built from zero, with tracking that shows which ads bring real calls. Your Google Business Profile, filled in properly.",
  },
  {
    n: "02",
    title: "Qualify and route",
    copy: "Every inquiry gets a reply in under five minutes and goes to the right person. Nobody has to sit and watch an inbox.",
  },
  {
    n: "03",
    title: "Quote",
    copy: "Your prices written down once. The estimate goes out while the customer still wants the job.",
  },
  {
    n: "04",
    title: "Book",
    copy: "The customer picks a time on their own. The job lands in your calendar.",
  },
];
---

<section class="section services" id="services">
  <div class="wrap services__grid">
    <div class="services__aside">
      <div class="services__stick">
        <h2 data-reveal>One system, from the first click to the booked job</h2>
        <p class="lede" data-reveal style="--delay:120ms">
          A website, an ads account, and an automation, wired together. That is the version that
          still works at 9pm on a Saturday.
        </p>
      </div>
    </div>

    <ol class="services__list">
      {
        stages.map((s, i) => (
          <li class="svc" data-reveal style={`--delay:${i * 70}ms`}>
            <span class="svc__icon" aria-hidden="true">{s.n}</span>

            <div class="svc__text">
              <h3>{s.title}</h3>
              <p>{s.copy}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services {
    background: var(--haze);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .services__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(38px, 6vw, 92px);
  }

  .services__stick {
    position: sticky;
    top: 130px;
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .services__list {
    display: grid;
  }

  .svc {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 22px;
    padding: 30px 26px 30px 0;
    border-top: 1px solid var(--line-strong);
    position: relative;
    transition: padding 0.45s var(--ease);
  }

  .svc:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .svc::before {
    content: "";
    position: absolute;
    inset: 0 -22px;
    background: var(--paper);
    opacity: 0;
    transform: scaleX(0.97);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
    z-index: -1;
  }

  .svc:hover::before {
    opacity: 1;
    transform: none;
  }

  .svc:hover {
    padding-left: 12px;
  }

  .svc__icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--ink-2);
    transition: color 0.4s var(--ease), border-color 0.4s var(--ease), transform 0.5s var(--ease);
  }

  .svc__icon {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }


  .svc:hover .svc__icon {
    color: var(--blue);
    border-color: var(--blue);
    transform: rotate(-6deg) scale(1.06);
  }

  .svc__text {
    display: grid;
    gap: 9px;
  }

  .svc__text p {
    color: var(--mute);
    font-size: 0.98rem;
    line-height: 1.66;
    max-width: 56ch;
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
    }

    .services__stick {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .svc {
      grid-template-columns: 1fr;
      gap: 16px;
      padding-right: 0;
    }

    .svc:hover {
      padding-left: 0;
    }
  }
</style>
