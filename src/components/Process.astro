---
const steps = [
  {
    n: "01",
    title: "Call",
    copy: "Thirty minutes, free. You tell me where leads are going cold, or what your team keeps redoing by hand every week. I tell you what I would build and what it costs.",
  },
  {
    n: "02",
    title: "Build",
    copy: "I build the site, the ads account, and the automation. Live in 30 days from the day your last file reaches me. You watch it go up, you do not wait for a reveal.",
  },
  {
    n: "03",
    title: "Run",
    copy: "I run the ads account, watch the automation, reconnect logins when they expire, and fix anything that breaks in what I built. New features, and changes to how the system works, are quoted separately. Month to month after the first three.",
  },
];
---

<section class="section process dark">
  <div class="wrap">
    <div class="process__head">
      <h2 data-reveal>How working together goes</h2>
    </div>

    <ol class="process__list">
      {
        steps.map((s, i) => (
          <li class="step" data-reveal style={`--delay:${i * 110}ms`}>
            <span class="step__n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.copy}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--navy);
  }

  .process__head {
    display: grid;
    gap: 20px;
    max-width: 60ch;
    margin-bottom: clamp(48px, 6vw, 80px);
  }

  .process__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line-dark);
    border: 1px solid var(--line-dark);
  }

  .step {
    background: var(--navy);
    padding: clamp(28px, 3.2vw, 44px);
    display: grid;
    gap: 14px;
    align-content: start;
    position: relative;
    transition: background 0.5s var(--ease);
  }

  .step::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: 100%;
    background: var(--cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }

  .step:hover {
    background: var(--navy-2);
  }

  .step:hover::after {
    transform: scaleX(1);
  }

  .step__n {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--cyan);
  }

  .step p {
    color: var(--mute-dark);
    font-size: 0.98rem;
    line-height: 1.66;
  }

  @media (max-width: 860px) {
    .process__list {
      grid-template-columns: 1fr;
    }
  }
</style>
