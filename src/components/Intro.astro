---
const clients = [
  "ADM Home Services",
  "Alita Construction Services",
  "The Judge's Mansion",
  "Pacific Premier Insurance Associates",
];

const problem = [
  "A lead fills in your form at 2pm. Nobody sees it until 7. By then he has called two other companies.",
  "A quote takes three days because it waits on someone to sit down and write it.",
  "A call comes in at 6pm on a Friday. Nobody picks up. He does not call back on Monday.",
  "None of this is a people problem. Nobody built the machinery.",
];
---

<section class="clients dark" aria-label="Clients">
  <div class="wrap clients__wrap">
    <p class="clients__proof" data-reveal>
      From a home services company in Atlanta to a general contractor with $7.5 billion in
      transactions behind it.
    </p>
    <div class="clients__inner">
      <p class="clients__label tag" data-reveal>Clients</p>
      <ul class="clients__list">
        {
          clients.map((c, i) => (
            <li data-reveal style={`--delay:${100 + i * 90}ms`}>
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section class="section intro">
  <div class="wrap intro__grid">
    <div data-reveal>
      <h2>Where the money actually goes</h2>
    </div>

    <div class="intro__body">
      {
        problem.map((p, i) => (
          <p class="lede" data-reveal style={`--delay:${120 + i * 60}ms`}>
            {p}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  .clients {
    border-bottom: 1px solid var(--line-dark);
    padding-block: 34px;
  }

  .clients__wrap {
    display: grid;
    gap: 22px;
  }

  .clients__proof {
    font-size: clamp(1.02rem, 1.25vw, 1.16rem);
    line-height: 1.6;
    color: #fff;
    max-width: 62ch;
  }

  .clients__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 14px 40px;
  }

  .clients__label {
    flex: none;
    margin: 0;
  }

  .clients__list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 34px;
  }

  .clients__list li {
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: rgba(233, 237, 247, 0.72);
    position: relative;
    transition: color 0.3s var(--ease);
  }

  .clients__list li:hover {
    color: #fff;
  }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .intro__body {
    display: grid;
    gap: 22px;
  }

  @media (max-width: 860px) {
    .intro__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
