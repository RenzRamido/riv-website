---
import fs from "node:fs";
import path from "node:path";
import Diagram from "./Diagram.astro";

// Real build screenshots. Drop image files into public/work/ and name them with
// the project id as the prefix, for example: adm-1.png, ppia-1.png
const shotDir = path.join(process.cwd(), "public", "work");
let shotFiles = [];
try {
  shotFiles = fs
    .readdirSync(shotDir)
    .filter((f) => /\.(png|jpe?g|webp|avif)$/i.test(f))
    .sort();
} catch (e) {
  shotFiles = [];
}
const shotsFor = (id) => shotFiles.filter((f) => f.toLowerCase().startsWith(id + "-"));

const projects = [
  {
    id: "adm",
    client: "ADM Home Services",
    title: "Lead to booked job, home services company, Atlanta",
    problem:
      "Leads waited on a person to price them, and the good ones went cold before the quote went out.",
    built:
      "An intake to booking system. The customer describes the job, more than 60 service pricing rules set the price, an AI step drafts the estimate, the quote goes out, and the booking is handed to the CRM through its GraphQL API. Duplicates are blocked, two requests arriving at the same moment cannot collide, and cancellations map back cleanly. First built in Zapier, then rebuilt in n8n for reliability.",
    stack: ["n8n", "Zapier", "GraphQL CRM API", "Pricing rules", "AI estimate"],
    diagram: "intake",
  },
  {
    id: "acs-ads",
    client: "Alita Construction Services",
    title: "Google Ads account built from scratch, multi-state general contractor",
    problem:
      "There was no ads account, and the website's form tracking counted failed submissions as wins.",
    built:
      "The full campaign structure built from zero, call conversion tracking, negative keyword management, and video assets. Then a fix for form conversion tracking that was counting failed submissions as wins.",
    stack: ["Google Ads", "GA4", "Google Tag Manager"],
    diagram: "ads",
  },
];
---

<section class="section work" id="work">
  <div class="wrap">
    <div class="work__head">
      <h2 data-reveal>Two systems, built and running</h2>
      <p class="lede" data-reveal style="--delay:120ms">
        The diagrams are the real shape of each build. Client data stays out of them.
      </p>
    </div>
  </div>

  <div class="wrap work__list">
    {
      projects.map((p, i) => (
        <article class="proj" id={p.id}>
          <div class="proj__media" data-reveal>
            <Diagram kind={p.diagram} />

            {shotsFor(p.id).length > 0 && (
              <div class="shots">
                <p class="shots__label tag">From the actual build</p>
                <ul class="shots__row">
                  {shotsFor(p.id).map((f, n) => (
                    <li>
                      <button class="shot" type="button" data-shot={`/work/${f}`} aria-label={`Open build screenshot ${n + 1} for ${p.client}`}>
                        <img src={`/work/${f}`} alt="" loading="lazy" decoding="async" />
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <div class="proj__body">
            <p class="proj__client tag" data-reveal>
              {p.client}
            </p>
            <h3 data-reveal style="--delay:80ms">
              {p.title}
            </h3>

            <p class="proj__problem" data-reveal style="--delay:140ms">
              {p.problem}
            </p>
            <p class="proj__built" data-reveal style="--delay:200ms">
              {p.built}
            </p>

            <ul class="chips" data-reveal style="--delay:260ms">
              {p.stack.map((s) => (
                <li>{s}</li>
              ))}
            </ul>

            <p class="metric" data-reveal style="--delay:300ms">[METRIC: to be supplied]</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<div class="lb" data-lb hidden>
  <button class="lb__close" type="button" data-lb-close aria-label="Close image">Close</button>
  <img class="lb__img" data-lb-img src="" alt="Screenshot of the real automation build" />
</div>

<script is:inline>
  (function () {
    var lb = document.querySelector("[data-lb]");
    if (!lb) return;
    var img = lb.querySelector("[data-lb-img]");
    var last = null;

    function open(src, btn) {
      img.src = src;
      lb.hidden = false;
      document.body.style.overflow = "hidden";
      last = btn;
      lb.querySelector("[data-lb-close]").focus();
    }

    function close() {
      lb.hidden = true;
      img.src = "";
      document.body.style.overflow = "";
      if (last) last.focus();
    }

    document.addEventListener("click", function (e) {
      var btn = e.target.closest("[data-shot]");
      if (btn) {
        open(btn.getAttribute("data-shot"), btn);
        return;
      }
      if (e.target.closest("[data-lb-close]") || e.target === lb) close();
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !lb.hidden) close();
    });
  })();
</script>

<style>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: rgba(5, 7, 15, 0.92);
    display: grid;
    place-items: center;
    padding: clamp(16px, 4vw, 48px);
  }

  .lb[hidden] {
    display: none;
  }

  .lb__img {
    max-width: 100%;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 4px;
    border: 1px solid var(--line-dark);
  }

  .lb__close {
    position: absolute;
    top: 20px;
    right: 24px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    color: #fff;
    padding: 9px 20px;
    font-size: 0.86rem;
    cursor: pointer;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .lb__close:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }
</style>

<style>
  .work__head {
    display: grid;
    gap: 20px;
    max-width: 62ch;
    margin-bottom: clamp(46px, 6vw, 78px);
  }

  .work__list {
    display: grid;
    gap: clamp(54px, 7vw, 108px);
  }

  .proj {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(30px, 4.5vw, 72px);
    align-items: center;
  }

  .proj:nth-child(even) .proj__media {
    order: 2;
  }

  .shots {
    margin-top: 18px;
    display: grid;
    gap: 10px;
  }

  .shots__label {
    margin: 0;
  }

  .shots__row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .shot {
    display: block;
    padding: 0;
    width: 104px;
    height: 68px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--haze);
    cursor: pointer;
    transition: border-color 0.35s var(--ease), transform 0.35s var(--ease);
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .shot:hover {
    border-color: var(--blue);
    transform: translateY(-2px);
  }

  .proj__body {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .proj__client {
    color: var(--blue);
    margin: 0;
  }

  .proj__problem {
    font-size: clamp(1.02rem, 1.2vw, 1.12rem);
    color: var(--ink-2);
    line-height: 1.6;
    padding-left: 18px;
    border-left: 2px solid var(--blue);
  }

  .proj__built {
    color: var(--mute);
    font-size: 0.98rem;
    line-height: 1.68;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }

  .chips li {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    padding: 6px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--mute);
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .proj:hover .chips li {
    border-color: var(--line-strong);
    color: var(--ink-2);
  }

  .metric {
    width: fit-content;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--mute);
    padding: 9px 14px;
    border: 1px dashed var(--line-strong);
    border-radius: 3px;
  }

  @media (max-width: 900px) {
    .proj {
      grid-template-columns: 1fr;
    }

    .proj:nth-child(even) .proj__media {
      order: 0;
    }
  }
</style>
